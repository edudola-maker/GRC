// Schéma GRC — Squelette plateforme complète
// Vision : ROADMAP.md + ARCHITECTURE.md
// Tâche = action (libre ou liée à un objet métier)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

// ─── Énumérations ───────────────────────────────────────────

enum StatutProjet {
  IDEE
  A_ETUDIER
  VALIDE
  PLANIFIE
  EN_COURS
  EN_VALIDATION
  DEPLOYE
  CLOTURE
  ABANDONNE
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  EN_ATTENTE
  A_VALIDER
  TERMINE
  ANNULE
}

/// Statut de la *définition* du contrôle (pas de son exécution).
/// L'exécution opérationnelle = tâches / occurrences liées.
enum StatutControleSCI {
  ACTIF
  SUSPENDU
}

enum StatutConseil {
  RECU
  EN_COURS
  EN_ATTENTE
  REPONDU
  CLOTURE
  ANNULE
}

enum StatutRisque {
  IDENTIFIE
  EN_EVALUATION
  EN_TRAITEMENT
  MAITRISE
  ACCEPTE
  CLOTURE
}

enum CategorieRisque {
  FINANCIER
  OPERATIONNEL
  CONFORMITE
  CYBERSECURITE
  REPORTING
  JURIDIQUE
  SYSTEME_INFORMATION
}

enum TypeDocument {
  DIRECTIVE
  PROCEDURE
  CHARTE
  POLITIQUE
  INSTRUCTION
  MODELE
  AUTRE
}

enum StrategieRisque {
  EVITER
  REDUIRE
  TRANSFERER
  ACCEPTER
}

enum TypeControle {
  MANUEL
  SEMI_AUTOMATIQUE
  AUTOMATIQUE
}

enum TypeObjetMetier {
  PROJET
  CONSEIL
  MISSION
  RISQUE
  CONTROLE_SCI
  DOCUMENT
  TACHE
  PROCESSUS
  /// Étape d’un processus (lien facultatif vers une étape précise).
  PROCESSUS_ETAPE
  /// Modèle de tâche (catalogue).
  MODELE_TACHE
  /// Unité (fiche métier — associations complémentaires via LienObjet).
  UNITE
  /// Objectif stratégique d’unité (≠ ObjectifAnnuel, ≠ ObjectifModule).
  OBJECTIF
  /// Famille d’activités (Unité → Macroprocessus → Processus).
  MACROPROCESSUS
  /// Actif du référentiel généralisé (IT / Physique / Humain / Prestataire).
  ACTIF_IT
}

enum StatutObjectif {
  EN_COURS
  ATTEINT
  REPORTE
  ABANDONNE
}

/// État de rédaction d’une box/section — distinct du statut métier de l’objet.
/// Missions : évolue vers A_VALIDER / VALIDE (visas) sans concurrencer MissionValidationPoint.
enum EtatSectionRedaction {
  BROUILLON
  FINALISE
  A_VALIDER
  VALIDE
  OBSOLETE
}

enum StatutProcessus {
  ACTIF
  SUSPENDU
}

/// Type d’actif du référentiel généralisé (pas une CMDB).
/// Catégories : IT · Physique · Humain · Prestataire (dérivées en app).
enum TypeActifIT {
  APPLICATION
  SYSTEME
  INFRASTRUCTURE
  SERVICE
  AUTRE
  /// Physique
  LOCAL
  BATIMENT
  SALLE
  MATERIEL
  /// Humain / compétence critique (pas de personnes nominatives)
  COMPETENCE_CRITIQUE
  FONCTION_CRITIQUE
  /// Prestataire / tiers (MVP léger)
  PRESTATAIRE
}

enum StatutActifIT {
  ACTIF
  EN_PROJET
  OBSOLETE
  ARCHIVE
}

/// Rôle RACI sur une ligne d’activité / étape de processus.
enum RoleRaci {
  R
  A
  C
  I
}

/// Criticité de continuité (≠ matrice risque 5×5).
enum CriticiteContinuité {
  FAIBLE
  MODEREE
  ELEVEE
  CRITIQUE
}

/// Unité de durée BCM légère (MTPD / RTO / RPO).
enum UniteDureeContinuité {
  HEURES
  JOURS
}

enum TypeNoteTravail {
  TRAVAIL
  SEANCE
}

enum StatutDocMission {
  DEMANDE
  RECU
  ANALYSE
}


/// Classification LPD / confidentialité (socle — règles avancées en roadmap).
enum NiveauConfidentialite {
  PUBLIC
  INTERNE
  CONFIDENTIEL
  SENSIBLE
}

enum StatutDocument {
  BROUILLON
  EN_VIGUEUR
  A_REVOIR
  OBSOLETE
  ARCHIVE
}

enum FrequenceRevue {
  ANNUELLE
  BIANNUELLE
  TRIENNALE
  PONCTUELLE
}

enum StatutMission {
  PLANIFIE
  EN_COURS
  EN_REVUE
  TERMINE
  ANNULE
}

enum StatutValidationMission {
  BROUILLON
  SOUMIS
  VALIDE
  RETOUR
  OBSOLETE
}

enum NiveauVisa {
  REVU
  VALIDE
}

enum StatutRecommandation {
  OUVERTE
  EN_COURS
  CLOTUREE
  ANNULEE
}

enum Priorite {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}

enum FrequenceControle {
  MENSUELLE
  TRIMESTRIELLE
  SEMESTRIELLE
  ANNUELLE
  PONCTUELLE
}

enum CategorieTache {
  CONSEIL
  PROJET
  ADMINISTRATIF
  SCI
  MISSION
  DOCUMENT
  AUTRE
}

enum RoleUtilisateur {
  COLLABORATEUR
  RESPONSABLE
  ADMINISTRATEUR
}

enum ModuleMetier {
  PROJET
  CONSEIL
  MISSION
  RISQUE
  CONTROLE_SCI
  DOCUMENT
}

/// Types de listes gérées plus tard via Administration.
enum TypeReferentiel {
  TAXINOMIE
}

// ─── Unité (périmètre + fiche métier de pilotage) ───────────
/// Socle multi-unités ; fiche /unite = agrégateur + objectifs.
/// Admin technique des unités / droits = roadmap séparée.

model Unite {
  id            String   @id @default(cuid())
  code          String   @unique
  nom           String
  /// Mission / description synthétique de l’unité (Admin / court).
  description   String?
  /// Présentation narratif libre (carte d’identité) — rôle, finalité, organisation.
  presentation  String?
  responsableId String?
  adjointId     String?
  actif         Boolean  @default(true)
  creeLe        DateTime @default(now())
  modifieLe     DateTime @updatedAt

  responsable      Utilisateur?          @relation("UniteResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  adjoint          Utilisateur?          @relation("UniteAdjoint", fields: [adjointId], references: [id], onDelete: SetNull)
  utilisateurs     Utilisateur[]         @relation("UtilisateurUnite")
  projets          Projet[]
  conseils         Conseil[]
  taches           Tache[]
  controlesSCI     ControleSCI[]
  risques          Risque[]
  documents        Document[]
  missions         Mission[]
  processus        Processus[]
  macroprocessus   Macroprocessus[]
  modelesTache     ModeleTache[]
  recommandations  Recommandation[]
  objectifs        Objectif[]
  objectifsAnnuels ObjectifAnnuel[]
  objectifsModule  ObjectifModule[]
  sequences        SequenceCode[]
  journal          JournalEvenement[]
  notesTravail    NoteTravail[]
  journalBord     JournalBordEntree[]
  historiquesModification HistoriqueModification[]
  parametres       ParametreFonctionnel[]
  liensObjets      LienObjet[]
  sectionsRedaction SectionRedaction[]
  risquesReevaluations RisqueReevaluation[]
  actifsIT         ActifIT[]
  /// Missions institutionnelles / attributions permanentes (≠ Mission d’assurance).
  attributions         UniteAttribution[]
  macroprocessusApplicables MacroprocessusUniteApplicable[]
  processusApplicables      ProcessusUniteApplicable[]
}

/// Attribution / mission institutionnelle d’une Unité (référentiel gouvernance).
/// Distinct de l’objet Mission (audits / revues d’assurance).
model UniteAttribution {
  id          String   @id @default(cuid())
  uniteId     String
  titre       String
  description String?
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  creeLe      DateTime @default(now())
  modifieLe   DateTime @updatedAt

  unite Unite @relation(fields: [uniteId], references: [id], onDelete: Cascade)

  @@index([uniteId, ordre])
}

// ─── Utilisateur ────────────────────────────────────────────

model Utilisateur {
  id         String           @id @default(cuid())
  uniteId    String
  nom        String
  prenom     String
  /// Fonction / titre (ex. Responsable GRC).
  fonction   String?
  /// Représentation visuelle compacte (ex. JD) — jamais l’identifiant technique.
  initiales  String?
  email      String           @unique
  motDePasse String
  role       RoleUtilisateur  @default(COLLABORATEUR)
  actif      Boolean          @default(true)
  creeLe     DateTime         @default(now())
  modifieLe  DateTime         @updatedAt

  unite                   Unite              @relation("UtilisateurUnite", fields: [uniteId], references: [id])
  unitesResponsable       Unite[]            @relation("UniteResponsable")
  unitesAdjoint           Unite[]            @relation("UniteAdjoint")
  projetsResponsable      Projet[]           @relation("ProjetResponsable")
  tachesResponsable       Tache[]            @relation("TacheResponsable")
  controlesResponsable    ControleSCI[]      @relation("ControleResponsable")
  conseilsResponsable     Conseil[]          @relation("ConseilResponsable")
  risquesResponsable      Risque[]           @relation("RisqueResponsable")
  documentsResponsable    Document[]         @relation("DocumentResponsable")
  missionsResponsable     Mission[]          @relation("MissionResponsable")
  processusResponsable    Processus[]        @relation("ProcessusResponsable")
  recommandationsResp     Recommandation[]   @relation("RecoResponsable")
  objectifsResponsable    Objectif[]         @relation("ObjectifResponsable")
  objectifsCrees          Objectif[]         @relation("ObjectifCreePar")
  objectifsModifies       Objectif[]         @relation("ObjectifModifiePar")
  actifsITResponsable     ActifIT[]          @relation("ActifITResponsable")
  macroprocessusResponsable Macroprocessus[] @relation("MacroprocessusResponsable")

  projetsCrees            Projet[]           @relation("ProjetCreePar")
  projetsModifies         Projet[]           @relation("ProjetModifiePar")
  tachesCrees             Tache[]            @relation("TacheCreePar")
  tachesModifiees         Tache[]            @relation("TacheModifiePar")
  controlesCrees          ControleSCI[]      @relation("ControleCreePar")
  controlesModifies       ControleSCI[]      @relation("ControleModifiePar")
  conseilsCrees           Conseil[]          @relation("ConseilCreePar")
  conseilsModifies        Conseil[]          @relation("ConseilModifiePar")
  risquesCrees            Risque[]           @relation("RisqueCreePar")
  risquesModifies         Risque[]           @relation("RisqueModifiePar")
  documentsCrees          Document[]         @relation("DocumentCreePar")
  documentsModifies       Document[]         @relation("DocumentModifiePar")
  missionsCrees           Mission[]          @relation("MissionCreePar")
  missionsModifiees       Mission[]          @relation("MissionModifiePar")
  processusCrees          Processus[]        @relation("ProcessusCreePar")
  processusModifies       Processus[]        @relation("ProcessusModifiePar")
  actifsITCrees           ActifIT[]          @relation("ActifITCreePar")
  actifsITModifies        ActifIT[]          @relation("ActifITModifiePar")
  macroprocessusCrees     Macroprocessus[]   @relation("MacroprocessusCreePar")
  macroprocessusModifies  Macroprocessus[]   @relation("MacroprocessusModifiePar")
  historiquesTache        HistoriqueTache[]
  historiquesModification HistoriqueModification[]
  objectifs               ObjectifAnnuel[]
  projetMembres           ProjetMembre[]
  missionMembres          MissionMembre[]

  tachesSoumises          Tache[]            @relation("TacheSoumisePar")
  tachesValidees          Tache[]            @relation("TacheValideePar")
  controlesSoumis         ControleSCI[]      @relation("ControleSoumisPar")
  controlesValides        ControleSCI[]      @relation("ControleValidePar")
  checklistFaites         MissionChecklistItem[] @relation("ChecklistFaitPar")
  tacheChecklistFaites    TacheChecklistItem[] @relation("TacheChecklistFaitPar")
  modelesTacheCrees       ModeleTache[]        @relation("ModeleTacheCreePar")
  modelesTacheResponsable ModeleTache[]        @relation("ModeleTacheResponsableDefaut")
  modelesTacheProcessus   ModeleTacheProcessus[] @relation("ModeleTacheProcessusLiePar")
  documentsProcessus      DocumentProcessus[]    @relation("DocumentProcessusLiePar")
  processusActifsIT       ProcessusActifIT[]     @relation("ProcessusActifITLiePar")
  raciParticipants        ProcessusRaciParticipant[]
  continuiteModifiees     ProcessusContinuité[] @relation("ProcessusContinuitéModifiePar")
  validationsPreparees    MissionValidationPoint[] @relation("ValidationPreparePar")
  validationsSoumises     MissionValidationPoint[] @relation("ValidationSoumisPar")
  visasMission            MissionValidationVisa[]
  journalEvenements       JournalEvenement[]
  sectionsRedaction       SectionRedaction[] @relation("SectionRedactionModifiePar")
  risquesReevaluations    RisqueReevaluation[]
  notesTravailAuteur      NoteTravail[]      @relation("NoteTravailAuteur")
  noteParticipants        NoteParticipant[]
  journalBordAuteur       JournalBordEntree[] @relation("JournalBordAuteur")
}

// ─── Projet ─────────────────────────────────────────────────

model Projet {
  id            String       @id @default(cuid())
  uniteId       String
  code          String
  nom           String
  description   String?
  taxinomie     String?
  tags          String?
  responsableId String
  dateDebut     DateTime?
  /// Fin de la plage planifiée (≠ dateEcheance = deadline métier).
  dateFinPlanifiee DateTime?
  dateEcheance  DateTime?
  statut        StatutProjet @default(IDEE)
  priorite      Priorite     @default(MOYENNE)
  avancement    Int          @default(0)
  commentaires  String?
  /// Réflexion / analyse documentée (≠ journal d’activité).
  reflexion     String?
  archive       Boolean      @default(false)
  /// Version de contenu (historisation code / champs structurants).
  contenuVersion Int         @default(1)
  creeParId     String
  modifieParId  String
  creeLe        DateTime     @default(now())
  modifieLe     DateTime     @updatedAt
  meta          Json?

  unite       Unite           @relation(fields: [uniteId], references: [id])
  responsable Utilisateur     @relation("ProjetResponsable", fields: [responsableId], references: [id])
  creePar     Utilisateur     @relation("ProjetCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur     @relation("ProjetModifiePar", fields: [modifieParId], references: [id])
  taches      Tache[]
  dependancesTache TacheDependance[]
  membres     ProjetMembre[]
  /// Conservé pour migration — UI unifiée via LienObjet / Éléments associés.
  documents   ProjetDocument[]
  /// Étapes pondérées — avancement Projet = Σ (poids × avancement étape).
  etapes      ProjetEtape[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, statut])
}

/// Étape de Projet avec pondération et avancement 0–100 %.
/// Avancement global = Σ (poids × avancement) / 100 (poids en %, total 100).
model ProjetEtape {
  id          String   @id @default(cuid())
  projetId    String
  libelle     String
  ordre       Int      @default(0)
  /// Poids dans le projet (0–100). Somme des poids = 100.
  poids       Int      @default(0)
  /// Avancement de l’étape 0–100 (slider).
  avancement  Int      @default(0)
  termine     Boolean  @default(false)
  creeLe      DateTime @default(now())
  modifieLe   DateTime @updatedAt

  projet Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  @@index([projetId, ordre])
}

model ProjetMembre {
  id            String @id @default(cuid())
  projetId      String
  utilisateurId String

  projet      Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@unique([projetId, utilisateurId])
}

model ProjetDocument {
  id         String   @id @default(cuid())
  projetId   String
  documentId String
  creeLe     DateTime @default(now())

  projet   Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([projetId, documentId])
}

// ─── Conseil (objet métier) ─────────────────────────────────

model Conseil {
  id                String        @id @default(cuid())
  uniteId           String
  code              String
  objet             String
  description       String?
  taxinomie         String?
  tags              String?
  demandeur         String?
  entiteDemandeuse  String?
  dateReception     DateTime      @default(now())
  responsableId     String
  dateEcheance      DateTime?
  statut            StatutConseil @default(RECU)
  dateReponse       DateTime?
  dateCloture       DateTime?
  commentaires      String?
  /// Raisonnement ayant conduit à l’avis (≠ journal d’activité).
  raisonnement      String?
  /// Réponse / conclusion clairement identifiable (≠ journal, ≠ notes de travail).
  reponseConclusion String?
  /// Lien optionnel vers un conseil précédent (réouverture / suite).
  conseilPrecedentId String?
  archive           Boolean       @default(false)
  creeParId         String
  modifieParId      String
  creeLe            DateTime      @default(now())
  modifieLe         DateTime      @updatedAt
  meta              Json?

  unite       Unite       @relation(fields: [uniteId], references: [id])
  responsable Utilisateur @relation("ConseilResponsable", fields: [responsableId], references: [id])
  creePar     Utilisateur @relation("ConseilCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur @relation("ConseilModifiePar", fields: [modifieParId], references: [id])
  conseilPrecedent Conseil?  @relation("ConseilSuite", fields: [conseilPrecedentId], references: [id], onDelete: SetNull)
  conseilsSuites   Conseil[] @relation("ConseilSuite")
  taches      Tache[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, statut])
  @@index([conseilPrecedentId])
}

// ─── Tâche (action) ─────────────────────────────────────────

model Tache {
  id             String         @id @default(cuid())
  uniteId        String
  titre          String
  description    String?
  responsableId  String
  projetId       String?
  conseilId      String?
  controleSCIId  String?
  missionId      String?
  documentId     String?
  recommandationId String?
  /// Note de travail / séance à l’origine (si créée depuis une Note).
  noteTravailId  String?
  /// Lien optionnel vers un Risque GRC (création rapide depuis fiche risque).
  risqueId       String?
  /// Référence informative au modèle d’origine (pas de sync rétroactive).
  modeleTacheId  String?
  dateCreation   DateTime       @default(now())
  /// Début de la plage planifiée (quand on prévoit de travailler).
  dateDebut      DateTime?
  /// Fin de la plage planifiée (≠ dateEcheance = deadline).
  dateFinPlanifiee DateTime?
  dateEcheance   DateTime?
  /// Charge estimée en jours ouvrés (ex. 0.5, 1, 2, 5) — pilotage futur.
  chargeJours    Float?
  statut         StatutTache    @default(A_FAIRE)
  priorite       Priorite       @default(MOYENNE)
  categorie      CategorieTache @default(AUTRE)
  commentaires   String?

  soumisParId    String?
  valideParId    String?
  dateSoumission DateTime?
  dateValidation DateTime?

  creeParId    String
  modifieParId String
  creeLe       DateTime @default(now())
  modifieLe    DateTime @updatedAt
  meta         Json?

  unite          Unite           @relation(fields: [uniteId], references: [id])
  responsable    Utilisateur     @relation("TacheResponsable", fields: [responsableId], references: [id])
  projet         Projet?         @relation(fields: [projetId], references: [id], onDelete: SetNull)
  conseil        Conseil?        @relation(fields: [conseilId], references: [id], onDelete: SetNull)
  controleSCI    ControleSCI?    @relation(fields: [controleSCIId], references: [id], onDelete: SetNull)
  mission        Mission?        @relation(fields: [missionId], references: [id], onDelete: SetNull)
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  recommandation Recommandation? @relation(fields: [recommandationId], references: [id], onDelete: SetNull)
  noteTravail    NoteTravail?    @relation(fields: [noteTravailId], references: [id], onDelete: SetNull)
  risque         Risque?         @relation(fields: [risqueId], references: [id], onDelete: SetNull)
  modeleTache    ModeleTache?    @relation(fields: [modeleTacheId], references: [id], onDelete: SetNull)
  creePar        Utilisateur     @relation("TacheCreePar", fields: [creeParId], references: [id])
  modifiePar     Utilisateur     @relation("TacheModifiePar", fields: [modifieParId], references: [id])
  soumisPar      Utilisateur?    @relation("TacheSoumisePar", fields: [soumisParId], references: [id])
  validePar      Utilisateur?    @relation("TacheValideePar", fields: [valideParId], references: [id])
  historique     HistoriqueTache[]
  checklistItems TacheChecklistItem[]
  /// Prérequis dont cette tâche dépend (successeur).
  dependancesEnTantQueSuccesseur TacheDependance[] @relation("TacheSuccesseur")
  /// Tâches qui dépendent de celle-ci (prédécesseur).
  dependancesEnTantQuePrerequis  TacheDependance[] @relation("TachePrerequis")

  @@index([uniteId, statut, dateEcheance])
  @@index([modeleTacheId])
  @@index([noteTravailId])
  @@index([risqueId])
}

/// Dépendance optionnelle entre tâches d’un même Projet (activation progressive).
model TacheDependance {
  id          String @id @default(cuid())
  projetId    String
  /// Tâche successeur (bloquée tant que le prérequis n’est pas TERMINE).
  tacheId     String
  /// Tâche prérequis.
  prerequisId String
  creeLe      DateTime @default(now())

  projet    Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)
  tache     Tache  @relation("TacheSuccesseur", fields: [tacheId], references: [id], onDelete: Cascade)
  prerequis Tache  @relation("TachePrerequis", fields: [prerequisId], references: [id], onDelete: Cascade)

  @@unique([tacheId, prerequisId])
  @@index([projetId])
  @@index([prerequisId])
}

/// Étape de checklist d’une tâche (copie d’occurrence — ≠ modèle, ≠ checklist Mission).
model TacheChecklistItem {
  id        String    @id @default(cuid())
  tacheId   String
  libelle   String
  ordre     Int       @default(0)
  fait      Boolean   @default(false)
  faitParId String?
  faitLe    DateTime?
  /// Figé à la copie depuis le modèle (traçabilité, pas de sync).
  sourceModeleEtapeId String?

  tache   Tache        @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  faitPar Utilisateur? @relation("TacheChecklistFaitPar", fields: [faitParId], references: [id], onDelete: SetNull)

  @@index([tacheId, ordre])
}

model HistoriqueTache {
  id             String   @id @default(cuid())
  tacheId        String
  modifieParId   String
  modifieLe      DateTime @default(now())
  champModifie   String
  ancienneValeur String?
  nouvelleValeur String?

  tache      Tache       @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  modifiePar Utilisateur @relation(fields: [modifieParId], references: [id])
}

// ─── Contrôle SCI ───────────────────────────────────────────

model ControleSCI {
  id                      String            @id @default(cuid())
  uniteId                 String
  code                    String
  nom                     String
  description             String?
  taxinomie               String?
  tags                    String?
  processusConcerne       String
  responsableId           String
  typeControle            TypeControle      @default(MANUEL)
  frequence               FrequenceControle
  fenetreDeclenchementJours Int             @default(30)
  delaiRealisationJours   Int?
  dateDerniereRealisation DateTime?
  dateProchaineEcheance   DateTime?
  statut                  StatutControleSCI @default(ACTIF)
  commentaires            String?
  archive                 Boolean           @default(false)

  soumisParId    String?
  valideParId    String?
  dateSoumission DateTime?
  dateValidation DateTime?

  creeParId    String
  modifieParId String
  creeLe       DateTime @default(now())
  modifieLe    DateTime @updatedAt
  meta         Json?

  unite       Unite              @relation(fields: [uniteId], references: [id])
  responsable Utilisateur        @relation("ControleResponsable", fields: [responsableId], references: [id])
  creePar     Utilisateur        @relation("ControleCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur        @relation("ControleModifiePar", fields: [modifieParId], references: [id])
  soumisPar   Utilisateur?       @relation("ControleSoumisPar", fields: [soumisParId], references: [id])
  validePar   Utilisateur?       @relation("ControleValidePar", fields: [valideParId], references: [id])
  preuves     ControleDocument[]
  risques     RisqueControle[]
  taches      Tache[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, statut])
}

model ControleDocument {
  id            String   @id @default(cuid())
  controleSCIId String
  documentId    String
  typeLien      String   @default("preuve")
  creeLe        DateTime @default(now())

  controle ControleSCI @relation(fields: [controleSCIId], references: [id], onDelete: Cascade)
  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([controleSCIId, documentId])
}

// ─── Risque ─────────────────────────────────────────────────

model Risque {
  id            String           @id @default(cuid())
  uniteId       String
  code          String
  nom           String
  description   String?
  taxinomie     String?
  tags          String?
  /// @deprecated Libellé libre — préférer processusId (référentiel).
  processus     String?
  /// Lien vers le référentiel Processus (source de vérité).
  processusId   String?
  responsableId String
  categorie     CategorieRisque
  /// Risque inhérent (avant maîtrise)
  probabilite   Int              @default(1) // 1–5
  impact        Int              @default(1) // 1–5
  criticite     Int              @default(1) // probabilite × impact
  /// Risque résiduel (après maîtrise) — si null, égal à l'inhérent à l'affichage
  probabiliteResiduelle Int?
  impactResiduel        Int?
  criticiteResiduelle   Int?
  strategie     StrategieRisque?
  statut        StatutRisque     @default(IDENTIFIE)
  commentaires  String?
  /// Justification de l’évaluation / du traitement retenu (≠ journal).
  justificationEvaluation String?
  archive       Boolean          @default(false)
  /// Version de contenu (pilote versioning) — futurs visas stockent versionVisee.
  contenuVersion Int             @default(1)
  creeParId     String
  modifieParId  String
  creeLe        DateTime        @default(now())
  modifieLe     DateTime        @updatedAt
  meta          Json?

  unite       Unite            @relation(fields: [uniteId], references: [id])
  responsable Utilisateur      @relation("RisqueResponsable", fields: [responsableId], references: [id])
  creePar     Utilisateur      @relation("RisqueCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur      @relation("RisqueModifiePar", fields: [modifieParId], references: [id])
  processusRef Processus?      @relation(fields: [processusId], references: [id], onDelete: SetNull)
  controles   RisqueControle[]
  reevaluations RisqueReevaluation[]

  taches         Tache[]
  missionRisques MissionRisque[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, criticite])
  @@index([processusId])
}

/// Acte de réévaluation d’un risque (même si les notes ne changent pas).
/// Distinct de HistoriqueModification (diffs de champs).
model RisqueReevaluation {
  id                 String   @id @default(cuid())
  risqueId           String
  uniteId            String
  dateReevaluation   DateTime
  auteurId           String
  probabiliteAvant   Int
  impactAvant        Int
  criticiteAvant     Int
  probabiliteApres   Int
  impactApres        Int
  criticiteApres     Int
  probabiliteResiduelleAvant Int?
  impactResiduelAvant        Int?
  criticiteResiduelleAvant   Int?
  probabiliteResiduelleApres Int?
  impactResiduelApres        Int?
  criticiteResiduelleApres   Int?
  /// Réflexion / justification de la revue (niveau maintenu ou non).
  commentaire        String
  creeLe             DateTime @default(now())

  risque Risque      @relation(fields: [risqueId], references: [id], onDelete: Cascade)
  unite  Unite       @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  auteur Utilisateur @relation(fields: [auteurId], references: [id])

  @@index([risqueId, dateReevaluation])
  @@index([uniteId, dateReevaluation])
}

model RisqueControle {
  id            String   @id @default(cuid())
  risqueId      String
  controleSCIId String
  creeLe        DateTime @default(now())

  risque   Risque      @relation(fields: [risqueId], references: [id], onDelete: Cascade)
  controle ControleSCI @relation(fields: [controleSCIId], references: [id], onDelete: Cascade)

  @@unique([risqueId, controleSCIId])
}

// ─── Document (inventaire) ──────────────────────────────────

model Document {
  id                String          @id @default(cuid())
  uniteId           String
  code              String
  nom               String
  typeDocument      TypeDocument    @default(AUTRE)
  taxinomie         String?
  tags              String?
  version           String?
  responsableId     String?
  dateApprobation   DateTime?
  dateDerniereRevue DateTime?
  frequenceRevue    FrequenceRevue?
  prochaineRevue    DateTime?
  fenetreDeclenchementJours Int     @default(30)
  statut            StatutDocument  @default(BROUILLON)
  description       String?
  // Référence externe (ex. URL Confluence) — pas une GED
  reference         String?
  nomFichier        String?
  nomStockage       String?
  chemin            String?
  typeMime          String?
  taille            Int?
  /// LPD by design — socle (droits fins / rétention = roadmap).
  contientDonneesPersonnelles Boolean @default(false)
  niveauConfidentialite       NiveauConfidentialite @default(INTERNE)
  archive           Boolean         @default(false)
  creeParId         String
  modifieParId      String?
  creeLe            DateTime        @default(now())
  modifieLe         DateTime        @updatedAt
  meta              Json?

  unite       Unite              @relation(fields: [uniteId], references: [id])
  responsable Utilisateur?       @relation("DocumentResponsable", fields: [responsableId], references: [id])
  creePar     Utilisateur        @relation("DocumentCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur?       @relation("DocumentModifiePar", fields: [modifieParId], references: [id])
  controles   ControleDocument[]
  projets     ProjetDocument[]
  missions   MissionDocument[]
  tachesRevue Tache[]
  processus   DocumentProcessus[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, statut])
}

// ─── Mission (moteur générique : Type → Template → Instance) ─

/// Types paramétrables (seed / futur Éditeur).
model MissionType {
  id          String   @id @default(cuid())
  code        String   @unique
  libelle     String
  description String?
  actif       Boolean  @default(true)
  ordre       Int      @default(0)
  creeLe      DateTime @default(now())

  templates   MissionTemplate[]
  descriptifs MissionDescriptifPreset[]
  missions    Mission[]
}

/// Template méthodologique (sections, rôles, check-lists, validations).
model MissionTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  libelle     String
  typeId      String
  description String?
  actif       Boolean  @default(true)
  /// { sections, roleCodes, checklistDefs, validationDefs }
  definition  Json
  /// LPD by design — le template peut préqualifier les instances.
  contientDonneesPersonnelles Boolean @default(false)
  niveauConfidentialite       NiveauConfidentialite @default(INTERNE)
  creeLe      DateTime @default(now())

  type     MissionType @relation(fields: [typeId], references: [id])
  missions Mission[]
}

/// Descriptifs standardisés par type (+ option « Mission spécifique » en UI).
model MissionDescriptifPreset {
  id          String   @id @default(cuid())
  typeId      String
  libelle     String
  description String?
  actif       Boolean  @default(true)
  ordre       Int      @default(0)

  type     MissionType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  missions Mission[]

  @@index([typeId, actif])
}

/// Rôles *dans* une mission (≠ RoleUtilisateur applicatif).
model MissionRole {
  id      String  @id @default(cuid())
  code    String  @unique
  libelle String
  actif   Boolean @default(true)
  ordre   Int     @default(0)

  membreRoles MissionMembreRole[]
}

model Mission {
  id                 String        @id @default(cuid())
  uniteId            String
  code               String
  titre              String
  typeId             String
  templateId         String
  descriptifPresetId String?
  /// Texte libre si « Mission spécifique » (pas de preset).
  descriptifLibre    String?
  /// Nature / périmètre complémentaire.
  nature             String?
  tags               String?
  responsableId      String
  dateDebut          DateTime?
  dateFin            DateTime?
  statut             StatutMission @default(PLANIFIE)
  commentaires       String?
  /// Analyses / réflexions relatives aux travaux (≠ journal d’activité).
  analyseTravaux     String?
  /// LPD by design — socle.
  contientDonneesPersonnelles Boolean @default(false)
  niveauConfidentialite       NiveauConfidentialite @default(INTERNE)
  /// Soft-delete / historique — pas de suppression physique des missions suivies.
  archive            Boolean       @default(false)
  /// Version de contenu (code, champs structurants) — historique générique.
  contenuVersion     Int           @default(1)
  creeParId          String
  modifieParId       String
  creeLe             DateTime      @default(now())
  modifieLe          DateTime      @updatedAt
  meta               Json?

  unite            Unite                    @relation(fields: [uniteId], references: [id])
  type             MissionType              @relation(fields: [typeId], references: [id])
  template         MissionTemplate          @relation(fields: [templateId], references: [id])
  descriptifPreset MissionDescriptifPreset? @relation(fields: [descriptifPresetId], references: [id], onDelete: SetNull)
  responsable      Utilisateur              @relation("MissionResponsable", fields: [responsableId], references: [id])
  creePar          Utilisateur              @relation("MissionCreePar", fields: [creeParId], references: [id])
  modifiePar       Utilisateur              @relation("MissionModifiePar", fields: [modifieParId], references: [id])
  membres          MissionMembre[]
  taches           Tache[]
  documents        MissionDocument[]
  recommandations  Recommandation[]
  checklistItems   MissionChecklistItem[]
  validationPoints MissionValidationPoint[]
  objectifsMission MissionObjectif[]
  risquesMission   MissionRisque[]
  documentationDemandee MissionDocumentation[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, statut])
}

model MissionMembre {
  id            String @id @default(cuid())
  missionId     String
  utilisateurId String

  mission     Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur         @relation(fields: [utilisateurId], references: [id])
  roles       MissionMembreRole[]

  @@unique([missionId, utilisateurId])
}

model MissionMembreRole {
  id      String @id @default(cuid())
  membreId String
  roleId   String

  membre MissionMembre @relation(fields: [membreId], references: [id], onDelete: Cascade)
  role   MissionRole   @relation(fields: [roleId], references: [id])

  @@unique([membreId, roleId])
}

model MissionDocument {
  id         String   @id @default(cuid())
  missionId  String
  documentId String
  creeLe     DateTime @default(now())

  mission  Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([missionId, documentId])
}

/// Recommandation suivie dans le temps (REC-xxxx) — survivit à la clôture / archivage mission.
model Recommandation {
  id            String               @id @default(cuid())
  uniteId       String
  code          String
  missionId     String
  titre         String
  description   String?
  responsableId String?
  dateEcheance  DateTime?
  statut        StatutRecommandation @default(OUVERTE)
  commentaires  String?
  archive       Boolean              @default(false)
  creeLe        DateTime             @default(now())
  modifieLe     DateTime             @updatedAt

  /// Restrict : une mission avec historique s’archive, elle ne se supprime pas.
  unite       Unite        @relation(fields: [uniteId], references: [id])
  mission     Mission      @relation(fields: [missionId], references: [id], onDelete: Restrict)
  responsable Utilisateur? @relation("RecoResponsable", fields: [responsableId], references: [id])
  taches      Tache[]

  @@unique([uniteId, code])
  @@index([missionId, statut])
}

/// Check-list méthodologique / qualité (≠ tâche opérationnelle).
model MissionChecklistItem {
  id        String    @id @default(cuid())
  missionId String
  sectionKey String
  code      String
  libelle   String
  fait      Boolean   @default(false)
  faitParId String?
  faitLe    DateTime?
  ordre     Int       @default(0)

  mission Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  faitPar Utilisateur? @relation("ChecklistFaitPar", fields: [faitParId], references: [id])

  @@unique([missionId, code])
  @@index([missionId, sectionKey])
}

/// Point de validation / contrôle qualité (Préparer → Soumettre → Valider).
model MissionValidationPoint {
  id             String                  @id @default(cuid())
  missionId      String
  sectionKey     String
  code           String
  libelle        String
  statut         StatutValidationMission @default(BROUILLON)
  /// Incrémenté si l’élément validé est modifié de façon significative → visas obsolètes.
  contenuVersion Int                     @default(1)
  prepareParId   String?
  prepareLe      DateTime?
  soumisParId    String?
  soumisLe       DateTime?

  mission    Mission                 @relation(fields: [missionId], references: [id], onDelete: Cascade)
  preparePar Utilisateur?            @relation("ValidationPreparePar", fields: [prepareParId], references: [id])
  soumisPar  Utilisateur?            @relation("ValidationSoumisPar", fields: [soumisParId], references: [id])
  visas      MissionValidationVisa[]

  @@unique([missionId, code])
  @@index([missionId, sectionKey, statut])
}

model MissionValidationVisa {
  id            String     @id @default(cuid())
  pointId       String
  utilisateurId String
  niveau        NiveauVisa
  date          DateTime   @default(now())
  /// Version du point au moment du visa.
  versionVisee  Int        @default(1)
  commentaire   String?

  point       MissionValidationPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur            @relation(fields: [utilisateurId], references: [id])

  @@index([pointId, niveau])
}

// ─── Objectifs annuels (collaborateur) ───────────────────────

/// Objectif stratégique / métier d’une unité (OBJ-xxxx).
/// Distinct de ObjectifAnnuel (individu) et ObjectifModule (KPI module).
/// Associations libres via LienObjet (type OBJECTIF).
model Objectif {
  id            String         @id @default(cuid())
  uniteId       String
  code          String
  intitule      String
  description   String?
  /// Cible éventuelle (texte libre : « 8 audits », « 95 % », …).
  cible         String?
  /// Progression 0–100 (saisie ; pas de calcul auto pour l’instant).
  progression   Int            @default(0)
  annee         Int
  responsableId String
  statut        StatutObjectif @default(EN_COURS)
  priorite      Priorite       @default(MOYENNE)
  dateEcheance  DateTime?
  creeParId     String
  modifieParId  String
  creeLe        DateTime       @default(now())
  modifieLe     DateTime       @updatedAt

  unite       Unite       @relation(fields: [uniteId], references: [id])
  responsable Utilisateur @relation("ObjectifResponsable", fields: [responsableId], references: [id])
  creePar     Utilisateur @relation("ObjectifCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur @relation("ObjectifModifiePar", fields: [modifieParId], references: [id])

  @@unique([uniteId, code])
  @@index([uniteId, annee, statut])
  @@index([uniteId, intitule])
}

/// Objectif individuel collaborateur (année) — vue Équipe / Dashboard.
model ObjectifAnnuel {
  id            String    @id @default(cuid())
  uniteId       String
  utilisateurId String
  annee         Int
  objectif      String
  attenduAnnuel String?
  realiseADate  String?
  progression   Int       @default(0) // 0–100
  dateEcheance  DateTime?
  creeLe        DateTime  @default(now())
  modifieLe     DateTime  @updatedAt

  unite       Unite       @relation(fields: [uniteId], references: [id])
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([uniteId, annee])
}

/// Objectifs / KPI définis par module métier — le dashboard responsable agrège.
model ObjectifModule {
  id               String      @id @default(cuid())
  uniteId          String
  module           ModuleMetier
  annee            Int
  libelle          String
  /// Clé stable d'indicateur (ex. audits_realises) — calculée ou saisie.
  indicateurCle    String
  cibleNumerique   Float?
  realiseNumerique Float?
  uniteMesure      String?
  progression      Int         @default(0)
  dateEcheance     DateTime?
  commentaires     String?
  creeLe           DateTime    @default(now())
  modifieLe        DateTime    @updatedAt

  unite Unite @relation(fields: [uniteId], references: [id])

  @@unique([uniteId, module, annee, indicateurCle])
  @@index([uniteId, annee])
}

/// Listes configurables (Administration future) — taxinomies, etc.
model ReferentielValeur {
  id        String         @id @default(cuid())
  type      TypeReferentiel
  code      String
  label     String
  ordre     Int            @default(0)
  actif     Boolean        @default(true)
  creeLe    DateTime       @default(now())
  modifieLe DateTime       @updatedAt

  @@unique([type, code])
  @@index([type, actif, ordre])
}

/// Paramètres fonctionnels par unité (délai conseil, etc.) — Administration future.
model ParametreFonctionnel {
  id          String   @id @default(cuid())
  uniteId     String
  cle         String
  valeur      String
  description String?
  creeLe      DateTime @default(now())
  modifieLe   DateTime @updatedAt

  unite Unite @relation(fields: [uniteId], references: [id], onDelete: Cascade)

  @@unique([uniteId, cle])
}

// ─── Processus (référentiel / cartographie SCI) ─────────────
/// Définition d’un processus métier. Documentation détaillée → Confluence.
/// Associations libres via LienObjet (Risques, Contrôles SCI, Documents…).
/// parentId réservé aux futurs sous-processus (pas exposé UX pour l’instant).
/// Hiérarchie affichée : Macroprocessus → Processus (≠ ProcessusDependance).
model Processus {
  id            String          @id @default(cuid())
  uniteId       String
  code          String
  nom           String
  description   String?
  tags          String?
  responsableId String
  statut        StatutProcessus @default(ACTIF)
  /// Criticité métier optionnelle (1–5)
  criticite     Int?
  /// Lien Confluence (documentation) — pas une GED
  reference     String?
  parentId      String?
  /// Famille d’activités (Macroprocessus).
  macroprocessusId String?
  /// LPD by design — socle.
  contientDonneesPersonnelles Boolean @default(false)
  niveauConfidentialite       NiveauConfidentialite @default(INTERNE)
  archive       Boolean         @default(false)
  creeParId     String
  modifieParId  String
  creeLe        DateTime        @default(now())
  modifieLe     DateTime        @updatedAt
  meta          Json?

  unite       Unite       @relation(fields: [uniteId], references: [id])
  responsable Utilisateur @relation("ProcessusResponsable", fields: [responsableId], references: [id])
  creePar     Utilisateur @relation("ProcessusCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur @relation("ProcessusModifiePar", fields: [modifieParId], references: [id])
  parent      Processus?  @relation("ProcessusHierarchie", fields: [parentId], references: [id])
  enfants     Processus[] @relation("ProcessusHierarchie")
  macroprocessus Macroprocessus? @relation(fields: [macroprocessusId], references: [id], onDelete: SetNull)
  etapes      ProcessusEtape[]
  modelesTache ModeleTacheProcessus[]
  risques     Risque[]
  documents   DocumentProcessus[]
  actifsIT    ProcessusActifIT[]
  raciLignes  ProcessusRaciLigne[]
  continuite  ProcessusContinuité?
  dependDe    ProcessusDependance[] @relation("ProcessusDependant")
  dependants  ProcessusDependance[] @relation("ProcessusPrerequis")
  unitesApplicables ProcessusUniteApplicable[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, statut])
  @@index([parentId])
  @@index([macroprocessusId])
}

/// Unités pour lesquelles le Processus est applicable/visible (hors propriétaire).
/// Pas d’héritage automatique depuis le Macroprocessus.
model ProcessusUniteApplicable {
  id          String   @id @default(cuid())
  processusId String
  uniteId     String
  creeLe      DateTime @default(now())

  processus Processus @relation(fields: [processusId], references: [id], onDelete: Cascade)
  unite     Unite     @relation(fields: [uniteId], references: [id], onDelete: Cascade)

  @@unique([processusId, uniteId])
  @@index([uniteId])
}

/// Grande famille d’activités (Unité → Macroprocessus → Processus).
/// Volontairement léger : pas de Risques / Contrôles / RACI / Continuité / Actifs ici.
model Macroprocessus {
  id            String   @id @default(cuid())
  uniteId       String
  code          String
  nom           String
  /// Narratif / finalité.
  description   String?
  responsableId String?
  /// Ordre d’affichage dans l’arborescence.
  ordre         Int      @default(0)
  archive       Boolean  @default(false)
  creeParId     String
  modifieParId  String
  creeLe        DateTime @default(now())
  modifieLe     DateTime @updatedAt

  unite       Unite        @relation(fields: [uniteId], references: [id])
  responsable Utilisateur? @relation("MacroprocessusResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  creePar     Utilisateur  @relation("MacroprocessusCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur  @relation("MacroprocessusModifiePar", fields: [modifieParId], references: [id])
  processus   Processus[]
  unitesApplicables MacroprocessusUniteApplicable[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, ordre])
}

/// Unités pour lesquelles le Macroprocessus est applicable/visible (hors propriétaire).
model MacroprocessusUniteApplicable {
  id               String   @id @default(cuid())
  macroprocessusId String
  uniteId          String
  creeLe           DateTime @default(now())

  macroprocessus Macroprocessus @relation(fields: [macroprocessusId], references: [id], onDelete: Cascade)
  unite          Unite          @relation(fields: [uniteId], references: [id], onDelete: Cascade)

  @@unique([macroprocessusId, uniteId])
  @@index([uniteId])
}

/// Étapes ordonnées d’un processus (« quoi ») — le « comment » reste dans Confluence.
model ProcessusEtape {
  id          String @id @default(cuid())
  processusId String
  libelle     String
  ordre       Int    @default(0)

  processus Processus @relation(fields: [processusId], references: [id], onDelete: Cascade)
  raciLignes ProcessusRaciLigne[]

  @@index([processusId, ordre])
}

/// Ligne RACI d’un processus (activité / étape). Facultatif — un responsable principal peut suffire.
model ProcessusRaciLigne {
  id          String  @id @default(cuid())
  processusId String
  /// Étape liée si la ligne s’appuie sur le référentiel d’étapes.
  etapeId     String?
  /// Libellé d’activité (peut reprendre le libellé d’étape).
  activite    String
  ordre       Int     @default(0)
  creeLe      DateTime @default(now())
  modifieLe   DateTime @updatedAt

  processus    Processus                  @relation(fields: [processusId], references: [id], onDelete: Cascade)
  etape        ProcessusEtape?            @relation(fields: [etapeId], references: [id], onDelete: SetNull)
  participants ProcessusRaciParticipant[]

  @@index([processusId, ordre])
  @@index([etapeId])
}

/// Participant RACI — personne issue du référentiel Utilisateurs.
/// Architecture souple : plus tard une fonction/rôle pourra porter la responsabilité
/// (libelleFonction) sans imposer cette sophistication dès maintenant.
model ProcessusRaciParticipant {
  id              String   @id @default(cuid())
  ligneId         String
  role            RoleRaci
  utilisateurId   String?
  /// Réserve future : responsabilité portée par une fonction (pas une personne).
  libelleFonction String?
  creeLe          DateTime @default(now())

  ligne       ProcessusRaciLigne @relation(fields: [ligneId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur?       @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([ligneId, role])
  @@index([utilisateurId])
}

/// Référentiel Actifs (généralisé : IT / Physique / Humain / Prestataire).
/// Préfixe AIT-xxxx conservé pour l’historique ; libellé UI = « Actifs ».
/// Information / Données = inventaire séparé (roadmap).
model ActifIT {
  id             String       @id @default(cuid())
  uniteId        String
  code           String
  nom            String
  type           TypeActifIT  @default(APPLICATION)
  description    String?
  responsableId  String?
  statut         StatutActifIT @default(ACTIF)
  fournisseur    String?
  hebergement    String?
  /// Prestataire : service fourni.
  serviceFourni  String?
  /// Criticité éventuelle (1–5) — prestataire / actifs critiques.
  criticite      Int?
  archive        Boolean      @default(false)
  creeParId      String
  modifieParId   String
  creeLe         DateTime     @default(now())
  modifieLe      DateTime     @updatedAt

  unite       Unite          @relation(fields: [uniteId], references: [id])
  responsable Utilisateur?   @relation("ActifITResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  creePar     Utilisateur    @relation("ActifITCreePar", fields: [creeParId], references: [id])
  modifiePar  Utilisateur    @relation("ActifITModifiePar", fields: [modifieParId], references: [id])
  processus   ProcessusActifIT[]

  @@unique([uniteId, code])
  @@index([uniteId, archive, statut])
  @@index([uniteId, type])
}

/// Relation N–N Processus ↔ Actif IT.
model ProcessusActifIT {
  id          String   @id @default(cuid())
  processusId String
  actifITId   String
  lieParId    String
  lieLe       DateTime @default(now())

  processus Processus   @relation(fields: [processusId], references: [id], onDelete: Cascade)
  actifIT   ActifIT     @relation(fields: [actifITId], references: [id], onDelete: Cascade)
  liePar    Utilisateur @relation("ProcessusActifITLiePar", fields: [lieParId], references: [id])

  @@unique([processusId, actifITId])
  @@index([actifITId])
  @@index([processusId])
}

/// Analyse de continuité au niveau Processus (1–1 optionnel — pas de silo BCM).
model ProcessusContinuité {
  id                       String                 @id @default(cuid())
  processusId              String                 @unique
  criticite                CriticiteContinuité?
  consequencesInterruption String?
  mtpdValeur               Int?
  mtpdUnite                UniteDureeContinuité?
  rtoValeur                Int?
  rtoUnite                 UniteDureeContinuité?
  /// Facultatif — pertinent surtout si données / systèmes.
  rpoValeur                Int?
  rpoUnite                 UniteDureeContinuité?
  periodesCritiques        String?
  /// Mode dégradé / solution alternative + mesures (fusion UX).
  modeDegradeMesures       String?
  commentaire              String?
  dateDerniereRevue        DateTime?
  dateProchaineRevue       DateTime?
  modifieParId             String
  creeLe                   DateTime               @default(now())
  modifieLe                DateTime               @updatedAt

  processus  Processus   @relation(fields: [processusId], references: [id], onDelete: Cascade)
  modifiePar Utilisateur @relation("ProcessusContinuitéModifiePar", fields: [modifieParId], references: [id])
}

/// Dépendance Processus → Processus (liste, pas de graphe).
/// processusId dépend de dependDeId (amont).
model ProcessusDependance {
  id           String   @id @default(cuid())
  processusId  String
  dependDeId   String
  commentaire  String?
  creeLe       DateTime @default(now())

  processus Processus @relation("ProcessusDependant", fields: [processusId], references: [id], onDelete: Cascade)
  dependDe  Processus @relation("ProcessusPrerequis", fields: [dependDeId], references: [id], onDelete: Cascade)

  @@unique([processusId, dependDeId])
  @@index([dependDeId])
}

// ─── Modèle de tâche ────────────────────────────────────────
/// Référentiel par unité. Checklist d’occurrence = copie à la création
/// (TacheChecklistItem) — pas de synchronisation rétroactive.
/// Distinct de MissionChecklistItem (checklist de mission d’audit).

model ModeleTache {
  id                  String          @id @default(cuid())
  uniteId             String
  code                String
  nom                 String
  description         String?
  delaiJours          Int?
  responsableDefautId String?
  categorieDefaut     CategorieTache?
  actif               Boolean         @default(true)
  creeParId           String
  creeLe              DateTime        @default(now())
  modifieLe           DateTime        @updatedAt

  unite             Unite                  @relation(fields: [uniteId], references: [id])
  creePar           Utilisateur            @relation("ModeleTacheCreePar", fields: [creeParId], references: [id])
  responsableDefaut Utilisateur?           @relation("ModeleTacheResponsableDefaut", fields: [responsableDefautId], references: [id], onDelete: SetNull)
  etapes            ModeleTacheEtape[]
  processus         ModeleTacheProcessus[]
  taches            Tache[]

  @@unique([uniteId, code])
  @@index([uniteId, actif])
  @@index([uniteId, nom])
}

model ModeleTacheEtape {
  id            String   @id @default(cuid())
  modeleTacheId String
  ordre         Int      @default(0)
  libelle       String
  creeLe        DateTime @default(now())
  modifieLe     DateTime @updatedAt

  modeleTache ModeleTache @relation(fields: [modeleTacheId], references: [id], onDelete: Cascade)

  @@index([modeleTacheId, ordre])
}

/// Relation N–N dédiée Processus ↔ Modèle de tâche (≠ LienObjet).
model ModeleTacheProcessus {
  id            String   @id @default(cuid())
  modeleTacheId String
  processusId   String
  lieParId      String
  lieLe         DateTime @default(now())

  modeleTache ModeleTache @relation(fields: [modeleTacheId], references: [id], onDelete: Cascade)
  processus   Processus   @relation(fields: [processusId], references: [id], onDelete: Cascade)
  liePar      Utilisateur @relation("ModeleTacheProcessusLiePar", fields: [lieParId], references: [id])

  @@unique([modeleTacheId, processusId])
  @@index([processusId])
  @@index([modeleTacheId])
}

/// Relation N–N dédiée Document ↔ Processus (procédures liées à un ou plusieurs processus).
/// Distinct de LienObjet générique — cas d’usage métier explicite.
model DocumentProcessus {
  id          String   @id @default(cuid())
  documentId  String
  processusId String
  lieParId    String
  lieLe       DateTime @default(now())

  document  Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  processus Processus   @relation(fields: [processusId], references: [id], onDelete: Cascade)
  liePar    Utilisateur @relation("DocumentProcessusLiePar", fields: [lieParId], references: [id])

  @@unique([documentId, processusId])
  @@index([processusId])
  @@index([documentId])
}

/// État de rédaction d’une box (brouillon / finalisé…) — transversal, ≠ statut métier.
/// Pour les Missions, s’articule avec MissionValidationPoint (visas) sans le remplacer.
model SectionRedaction {
  id             String               @id @default(cuid())
  uniteId        String
  typeObjet      TypeObjetMetier
  objetId        String
  sectionKey     String
  etat           EtatSectionRedaction @default(BROUILLON)
  /// Incrémenté à chaque finalisation (et à la remise en édition d’une section validée).
  contenuVersion Int                  @default(1)
  modifieParId   String
  modifieLe      DateTime             @updatedAt

  unite      Unite       @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  modifiePar Utilisateur @relation("SectionRedactionModifiePar", fields: [modifieParId], references: [id])

  @@unique([typeObjet, objetId, sectionKey])
  @@index([typeObjet, objetId])
  @@index([uniteId, etat])
}

// Compteur pour codes stables PRO-0001, CNS-0001, … (par unité)
model SequenceCode {
  id       String @id @default(cuid())
  uniteId  String
  prefixe  String
  dernier  Int    @default(0)

  unite Unite @relation(fields: [uniteId], references: [id], onDelete: Cascade)

  @@unique([uniteId, prefixe])
}

/// Lien générique entre deux objets métier (bidirectionnel à la lecture).
model LienObjet {
  id        String         @id @default(cuid())
  uniteId   String
  typeA     TypeObjetMetier
  idA       String
  typeB     TypeObjetMetier
  idB       String
  libelle   String?
  creeParId String?
  creeLe    DateTime       @default(now())

  unite Unite @relation(fields: [uniteId], references: [id], onDelete: Cascade)

  @@unique([uniteId, typeA, idA, typeB, idB])
  @@index([uniteId, typeA, idA])
  @@index([uniteId, typeB, idB])
}

// Journal d'activité commun (Conseils en priorité, extensible)
model JournalEvenement {
  id            String         @id @default(cuid())
  uniteId       String?
  typeObjet     TypeObjetMetier
  objetId       String
  typeEvenement String
  message       String
  automatique   Boolean        @default(true)
  auteurId      String?
  creeLe        DateTime       @default(now())

  unite  Unite?       @relation(fields: [uniteId], references: [id], onDelete: SetNull)
  auteur Utilisateur? @relation(fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([typeObjet, objetId, creeLe])
  @@index([uniteId, creeLe])
}


// ─── Notes de travail / Séances (transversal Projet, Conseil, Mission) ───

/// Note de travail ou séance — espace de préparation / capture.
/// Distincte du Journal de bord (chronologie métier) et du Journal système.
model NoteTravail {
  id           String         @id @default(cuid())
  uniteId      String
  typeObjet    TypeObjetMetier
  objetId      String
  titre        String
  date         DateTime       @default(now())
  type         TypeNoteTravail @default(TRAVAIL)
  /// Rattachement optionnel à une étape Mission (ex. PLANIFICATION).
  etapeMission String?
  notesLibres  String?
  auteurId     String
  creeLe       DateTime       @default(now())
  modifieLe    DateTime       @updatedAt

  unite        Unite            @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  auteur       Utilisateur      @relation("NoteTravailAuteur", fields: [auteurId], references: [id])
  questions    NoteQuestion[]
  participants NoteParticipant[]
  taches       Tache[]

  @@index([typeObjet, objetId, date])
  @@index([uniteId, date])
  @@index([etapeMission])
}

model NoteQuestion {
  id       String  @id @default(cuid())
  noteId   String
  libelle  String
  reponse  String?
  ordre    Int     @default(0)

  note NoteTravail @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, ordre])
}

model NoteParticipant {
  id            String  @id @default(cuid())
  noteId        String
  /// Utilisateur interne (optionnel).
  utilisateurId String?
  /// Personne externe saisie librement (audité, partenaire…).
  nomExterne    String?

  note        NoteTravail  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([noteId])
}

// ─── Journal de bord métier (volontaire) ─────────────────────

/// Chronologie métier volontaire — ≠ Notes (espace de travail) ≠ JournalEvenement (système).
model JournalBordEntree {
  id       String         @id @default(cuid())
  uniteId  String
  typeObjet TypeObjetMetier
  objetId  String
  date     DateTime
  texte    String
  auteurId String
  /// Lien optionnel si issue d’une tâche clôturée (« Ajouter au journal »).
  tacheId  String?
  creeLe   DateTime       @default(now())

  unite  Unite       @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  auteur Utilisateur @relation("JournalBordAuteur", fields: [auteurId], references: [id])

  @@index([typeObjet, objetId, date])
  @@index([uniteId, date])
  @@index([tacheId])
}

// ─── Planification Mission — enrichissements ─────────────────

model MissionObjectif {
  id          String  @id @default(cuid())
  missionId   String
  libelle     String
  description String?
  ordre       Int     @default(0)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, ordre])
}

/// Risque propre à la mission (≠ Risque GRC référentiel). Lien GRC facultatif.
model MissionRisque {
  id          String  @id @default(cuid())
  missionId   String
  titre       String
  description String?
  risqueId    String?
  ordre       Int     @default(0)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  risque  Risque? @relation(fields: [risqueId], references: [id], onDelete: SetNull)

  @@index([missionId, ordre])
  @@index([risqueId])
}

model MissionDocumentation {
  id               String           @id @default(cuid())
  missionId        String
  documentAttendu  String
  interlocuteur    String?
  dateDemandee     DateTime?
  dateRecue        DateTime?
  statut           StatutDocMission @default(DEMANDE)
  ordre            Int              @default(0)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, ordre])
}


/// Historique de contenu générique (diffs champ-par-champ).
/// Phase 1 : pas de snapshot JSON, pas de purge automatique.
/// Conservation paramétrable ultérieurement (Protection des données).
model HistoriqueModification {
  id             String         @id @default(cuid())
  uniteId        String?
  typeObjet      TypeObjetMetier
  objetId        String
  /// Chemin stable du champ (ex. "statut", "probabilite").
  champ          String
  ancienneValeur String?
  nouvelleValeur String?
  modifieParId   String
  modifieLe      DateTime       @default(now())
  motif          String?
  /// Version de contenu de l’objet après ce lot de modifications.
  versionObjet   Int            @default(1)

  unite      Unite?       @relation(fields: [uniteId], references: [id], onDelete: SetNull)
  modifiePar Utilisateur  @relation(fields: [modifieParId], references: [id])

  @@index([typeObjet, objetId, modifieLe])
  @@index([uniteId, modifieLe])
  @@index([typeObjet, objetId, versionObjet])
}
