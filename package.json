{
  "name": "grc-pilotage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:filters": "tsx src/lib/inventory-filters.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
